# Neon Postgres (obligatorio)
# Consola de Neon → Connect → pooled connection string
DATABASE_URL=
# Endpoint directo para migraciones/DDL (opcional, recomendado)
DATABASE_URL_UNPOOLED=

# Better Auth (obligatorio)
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 — Producción: https://tu-dominio
BETTER_AUTH_URL=http://localhost:3000
# Orígenes extra separados por coma (producción, previews de Vercel)
BETTER_AUTH_TRUSTED_ORIGINS=

# Registro público. Poné true para cerrar el registro y crear usuarios por seed/DB.
DISABLE_PUBLIC_SIGNUP=false

# OAuth (opcional: si falta el par, el botón queda deshabilitado)
# Google: Cloud Console → Credentials → OAuth client (Web)
#   redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps
#   callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# FreeLLMAPI (opcional; si falta, la UI usa respuestas demo)
# Gateway OpenAI-compatible. Local por defecto; en producción apuntá a tu instancia.
# Usá el Base URL que muestra tu FreeLLMAPI (Zcode: http://127.0.0.1:31415/v1)
FREELLM_GATEWAY_URL=http://127.0.0.1:31415/v1
FREELLM_GATEWAY_KEY=
