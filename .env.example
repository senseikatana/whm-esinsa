# Neon Postgres (obligatorio)
DATABASE_URL=
# Alternativa sin pooler para migraciones locales:
DATABASE_URL_UNPOOLED=

# Better Auth (obligatorio)
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Orígenes extra separados por coma (producción, previews)
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth (opcional: si falta, el botón queda deshabilitado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DeepSeek API (opcional; también se puede cargar por usuario desde la UI)
DEEPSEEK_API_KEY=
