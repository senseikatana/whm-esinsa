{
  "name": "whm-esinsa",
  "version": "0.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint ./app",
    "lint:fix": "biome lint --write ./app",
    "format": "biome format ./app",
    "format:fix": "biome format --write ./app",
    "check": "biome check ./app",
    "check:fix": "biome check --write ./app",
    "db:auth:migrate": "nub x auth@latest migrate --config app/lib/auth.ts -y",
    "db:migrate": "nub scripts/db-migrate.ts",
    "db:seed": "nub scripts/seed.ts",
    "db:setup": "nub run db:auth:migrate && nub run db:migrate && nub run db:seed",
    "db:studio": "nub x drizzle-kit studio",
    "db:generate": "nub x drizzle-kit generate",
    "env:check": "nub scripts/check-env.ts",
    "postinstall": "next telemetry disable",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@apollo/server": "^5.5.1",
    "@as-integrations/next": "^4.1.0",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "graphql": "^17.1.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@graphql-tools/utils": "12.1.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,scss}": [
      "biome check --write"
    ]
  }
}
